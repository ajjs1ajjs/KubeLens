{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KubeLens",
  "version": "0.1.11",
  "identifier": "com.kubelens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KubeLens",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMkNGQzlGRkUwRDFGNEIKUldSTEh3MytuL3dzWEZybGRBaUZ3azViUitkS0hKZy9zam5zNnJoeVM2THhvQ1N4SmFtcWtGU3YK",
      "endpoints": [
        "https://github.com/ajjs1ajjs/KubeLens/releases/latest/download/latest.json"
      ]
    }
  }
}