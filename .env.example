# KubeLens Environment Variables
# Copy this file to .env and adjust values as needed.
# Note: This is a Tauri desktop application, so most configuration
# is handled via tauri.conf.json and the app's internal settings.

# Tauri Updater (for production releases)
# TAURI_SIGNING_PRIVATE_KEY=your_minisign_private_key_here
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your_key_password_if_encrypted

# Logging
# RUST_LOG=info,kubelens=debug,tauri=warn
# Set to "debug" for verbose logging, "trace" for maximum verbosity

# Kubeconfig
# KUBECONFIG=/path/to/your/kubeconfig
# Override the default kubeconfig location (~/.kube/config)

# Update Channel (for development/testing)
# TAURI_UPDATE_CHANNEL=stable
# Options: stable, beta, nightly

# Platform-specific
# On Windows, the app uses MSVC toolchain (pinned in rust-toolchain.toml)
# No additional environment variables required for standard operation.